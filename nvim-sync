#!/usr/bin/env bash
# Keep this nvim config in sync with origin.
#
#   nvim-sync          pull latest config, then sync plugins + mason tools
#   nvim-sync --push   commit local changes, push, then sync like above
set -euo pipefail

cd "$(dirname "$0")"

if [[ "${1:-}" == "--push" ]]; then
  git add -A
  if git diff --cached --quiet; then
    echo "no local changes to commit"
  else
    git commit -m "config: sync $(git diff --cached --stat | tail -1 | awk '{print $NF}')"
  fi
  git pull --rebase
  git push
else
  git pull --rebase
fi

# Sync plugins to the locked versions, then install any new mason tools.
nvim --headless "+Lazy restore" "+MasonInstallAll" +qa

echo "nvim config synced"
